# PostgreSQL
DATABASE_URL=postgresql+psycopg://smartpay:CHANGE_THIS_DB_PASSWORD@localhost:5433/smartpay
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_DEFAULT_USER=smartpay
RABBITMQ_DEFAULT_PASS=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
RABBITMQ_URL=amqp://smartpay:CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD@localhost:5672//

# JWT
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Webhooks
WEBHOOK_SECRET=CHANGE_THIS_WEBHOOK_SECRET